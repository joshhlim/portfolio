---
const chips = ["What's Josh's tech stack?", 'What certifications does he have?', 'What is GamBROle?'];
---
<button class="aj-fab" type="button" aria-label="Ask Josh, chat about Josh" aria-expanded="false" aria-controls="aj-panel">
  <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.4 8.4 0 0 1-12.2 7.5L3 21l2-5.6A8.4 8.4 0 1 1 21 11.5z"/></svg>
</button>
<section id="aj-panel" class="aj-panel" role="dialog" aria-label="Ask Josh" hidden>
  <header class="aj-head"><div><strong>Ask Josh</strong><span>Answers come only from this site</span></div>
    <button class="aj-x" type="button" aria-label="Close">×</button></header>
  <div class="aj-log" aria-live="polite">
    <p class="aj-msg bot">Hi! Ask me anything about Josh's work, skills or projects.</p>
    <div class="aj-chips">{chips.map(c => <button type="button" class="aj-chip">{c}</button>)}</div>
  </div>
  <form class="aj-form"><input name="q" maxlength="500" placeholder="Ask about Josh…" autocomplete="off" aria-label="Your question"/><button type="submit" aria-label="Send">
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></button></form>
</section>
<script>
const fab = document.querySelector<HTMLButtonElement>('.aj-fab')!;
const panel = document.getElementById('aj-panel')!;
const log = panel.querySelector<HTMLDivElement>('.aj-log')!;
const form = panel.querySelector<HTMLFormElement>('.aj-form')!;
const input = form.querySelector<HTMLInputElement>('input')!;
const history: { role: string; content: string }[] = [];
let busy = false;
const LKEY = 'aj-times', LMAX = 10, LWIN = 600000;
function toggle(open: boolean) {
  panel.hidden = !open; fab.setAttribute('aria-expanded', String(open));
  document.body.classList.toggle('aj-open', open);
  if (open) setTimeout(() => input.focus(), 50);
}
fab.addEventListener('click', () => toggle(panel.hidden));
panel.querySelector('.aj-x')!.addEventListener('click', () => toggle(false));
document.addEventListener('keydown', e => { if (e.key === 'Escape' && !panel.hidden) toggle(false); });
if (location.hash === '#ask') toggle(true);
window.addEventListener('hashchange', () => { if (location.hash === '#ask') toggle(true); });
function add(cls: string, text: string) {
  const p = document.createElement('p'); p.className = 'aj-msg ' + cls; p.textContent = text;
  log.appendChild(p); log.scrollTop = log.scrollHeight; return p;
}
function render(p: HTMLElement, raw: string, done: boolean) {
  const srcs = [...new Set([...raw.matchAll(/\[source:\s*(\/[a-z]*)\]/gi)].map(m => m[1].toLowerCase()))];
  p.textContent = raw.replace(/\[source:[^\]]*\]?/gi, '').trim() || (done ? '' : '…');
  if (done && srcs.length) {
    const s = document.createElement('span'); s.className = 'aj-src'; s.append('Source: ');
    srcs.forEach((u, i) => { const a = document.createElement('a'); a.href = u; a.textContent = u === '/' ? 'Home' : u.slice(1)[0].toUpperCase() + u.slice(2); if (i) s.append(' · '); s.append(a); });
    p.appendChild(s);
  }
  log.scrollTop = log.scrollHeight;
}
function localLimited() {
  let t: number[] = []; try { t = JSON.parse(localStorage.getItem(LKEY) || '[]'); } catch {}
  const now = Date.now(); t = t.filter(x => now - x < LWIN);
  if (t.length >= LMAX) return true;
  t.push(now); try { localStorage.setItem(LKEY, JSON.stringify(t)); } catch {} return false;
}
async function ask(q: string) {
  q = q.trim().slice(0, 500); if (!q || busy) return;
  panel.querySelector('.aj-chips')?.remove();
  add('me', q); input.value = '';
  const p = add('bot', '…');
  if (localLimited()) { p.classList.add('err'); p.textContent = "You've asked a lot of questions! Please try again in a few minutes."; return; }
  busy = true; form.classList.add('busy');
  history.push({ role: 'user', content: q });
  let raw = '';
  try {
    const r = await fetch('/api/ask', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ messages: history.slice(-6) }) });
    if (!r.ok || !r.body) {
      let msg = 'Something went wrong. Please try again later.';
      try { const j = await r.json(); if (j.error) msg = j.error; } catch {}
      p.classList.add('err'); p.textContent = msg; history.pop(); return;
    }
    const rd = r.body.getReader(), dec = new TextDecoder();
    for (;;) { const { done, value } = await rd.read(); if (done) break; raw += dec.decode(value, { stream: true }); render(p, raw, false); }
    if (!raw.trim()) { p.classList.add('err'); p.textContent = 'Ask Josh is busy right now. Please try again in a few minutes.'; history.pop(); return; }
    render(p, raw, true); history.push({ role: 'assistant', content: raw });
  } catch { p.classList.add('err'); p.textContent = 'Network error. Please try again.'; history.pop(); }
  finally { busy = false; form.classList.remove('busy'); }
}
form.addEventListener('submit', e => { e.preventDefault(); ask(input.value); });
panel.querySelectorAll<HTMLButtonElement>('.aj-chip').forEach(b => b.addEventListener('click', () => ask(b.textContent || '')));
</script>
<style is:global>
.aj-fab{position:fixed;right:24px;bottom:24px;z-index:40;width:52px;height:52px;border-radius:50%;display:grid;place-items:center;border:1px solid var(--line);background:var(--card);color:var(--acc);box-shadow:0 8px 24px var(--shadow);cursor:pointer;transition:transform .2s}
.aj-fab:hover{transform:translateY(-2px)}.aj-open .aj-fab{display:none}
.aj-panel{position:fixed;right:24px;bottom:24px;z-index:41;width:370px;height:520px;max-height:calc(100vh - 48px);display:flex;flex-direction:column;background:var(--card);border:1px solid var(--line);border-radius:16px;box-shadow:0 16px 48px var(--shadow);overflow:hidden}
.aj-panel[hidden]{display:none}
.aj-head{display:flex;justify-content:space-between;align-items:center;padding:14px 16px;border-bottom:1px solid var(--line)}
.aj-head div{display:flex;flex-direction:column;line-height:1.3}.aj-head span{font-size:.78rem;color:var(--mut)}
.aj-x{border:0;background:transparent;color:var(--mut);font-size:1.5rem;line-height:1;cursor:pointer;width:32px;height:32px;border-radius:8px}.aj-x:hover{background:var(--hover);color:var(--fg)}
.aj-log{flex:1;overflow-y:auto;padding:16px;display:flex;flex-direction:column;gap:10px}
.aj-msg{margin:0;padding:9px 13px;border-radius:12px;font-size:.92rem;max-width:88%;white-space:pre-wrap;word-wrap:break-word}
.aj-msg.bot{background:var(--hover);align-self:flex-start}.aj-msg.me{background:var(--acc);color:var(--on-btn);align-self:flex-end}
.aj-msg.err{background:var(--dev-bg);color:var(--dev-fg)}
.aj-src{display:block;margin-top:6px;font-size:.78rem;color:var(--mut)}.aj-src a{font-weight:500}
.aj-chips{display:flex;flex-wrap:wrap;gap:8px}
.aj-chip{border:1px solid var(--card-line);background:var(--tag-bg);color:var(--tag-fg);border-radius:99px;padding:6px 12px;font:inherit;font-size:.82rem;cursor:pointer}.aj-chip:hover{border-color:var(--acc)}
.aj-form{display:flex;gap:8px;padding:12px;border-top:1px solid var(--line)}
.aj-form input{flex:1;min-width:0;font:inherit;font-size:16px;padding:9px 12px;border:1px solid var(--line);border-radius:10px;background:var(--bg);color:var(--fg)}.aj-form input:focus{outline:2px solid var(--acc);outline-offset:-1px}
.aj-form button{width:40px;border:0;border-radius:10px;background:var(--acc);color:var(--on-btn);display:grid;place-items:center;cursor:pointer}
.aj-form.busy button{opacity:.5;cursor:wait}
@media(max-width:600px){.aj-fab{right:16px;bottom:16px}.aj-panel{left:0;right:0;bottom:0;width:auto;height:85vh;height:85dvh;max-height:none;border-radius:16px 16px 0 0;border-bottom:0}}
</style>
