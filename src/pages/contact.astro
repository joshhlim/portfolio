---
import Base from '../layouts/Base.astro';
import { contact, pageDescriptions } from '../data/site';
---
<Base title="Contact" description={pageDescriptions.contact}>
<p class="eyebrow reveal">Contact</p><h1 class="reveal">Let's talk</h1>
<p class="mut reveal" style="max-width:600px;font-size:1.08rem">{contact.intro}</p>
<div class="grid" style="margin-top:36px">{contact.channels.map(c=><a class="card reveal" href={c.url} target={c.url.startsWith('mailto')?undefined:'_blank'}><p class="eyebrow">{c.label}</p><h3 style="color:var(--fg)">{c.value}</h3><p class="mut" style="margin:0">Open ↗</p></a>)}</div>
<div class="reveal" style="margin-top:28px;display:flex;gap:10px;flex-wrap:wrap"><a class="btn" href="/card">Save my contact / Digital card</a></div>
</Base>
