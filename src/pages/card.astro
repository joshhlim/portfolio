---
import Base from '../layouts/Base.astro';
import { site, card } from '../data/site';
---
<Base title="Card" description={`${site.name}, ${card.title} at ${card.org}. ${site.tagline}`} bare>
<div class="nc">
  <div class="nc-photo"><img src={card.photo} alt={site.name} width="320" height="320"/></div>
  <div class="nc-body">
    <div class="nc-id">
      <div><h1>{site.name}</h1><p class="nc-title">{card.title}</p></div>
      <img class="nc-logo" src={card.logo} alt="National University Health System logo" width="181" height="137"/>
    </div>
    <p class="nc-org">{card.org}</p>
    <p class="mut nc-bio">{site.tagline}</p>
    <h2>Email</h2>
    <ul class="nc-rows">{card.emails.map(e=> <li><a href={`mailto:${e.value}`}><span class="mut">{e.label}</span><span>{e.value}</span></a></li>)}</ul>
    <h2>Links</h2>
    <div class="nc-links">{card.links.map(l=> <a class="btn ghost" href={l.url}>{l.label}</a>)}</div>
    <div class="nc-actions">
      <a class="btn" href={card.vcf} download="Josh Lim.vcf">Save contact</a>
      <a class="btn ghost" href="/">See my work →</a>
    </div>
  </div>
</div>
<style>
.nc{max-width:420px;margin:0 auto;background:var(--card);border:1px solid var(--line);border-radius:20px;overflow:hidden;box-shadow:0 12px 30px -12px var(--shadow)}
.nc-photo{background:#0a0a0a;aspect-ratio:4/3;overflow:hidden}.nc-photo img{width:100%;height:100%;object-fit:cover;object-position:50% 25%;display:block}
.nc-body{padding:22px}.nc-id{display:flex;justify-content:space-between;align-items:center;gap:12px}
h1{font-size:2rem;margin:0}.nc-title{margin:0;color:var(--acc);font-weight:600}.nc-logo{height:48px;width:auto;background:#fff;border-radius:8px;padding:4px}
.nc-org{margin:10px 0 0;font-weight:500}.nc-bio{margin:4px 0 18px}
h2{font-size:.78rem;text-transform:uppercase;letter-spacing:.1em;color:var(--mut);margin:16px 0 6px}
.nc-rows{list-style:none;margin:0;padding:0}.nc-rows a{display:flex;justify-content:space-between;gap:10px;padding:10px 0;border-bottom:1px solid var(--line);color:var(--fg);font-size:.93rem;word-break:break-all}
.nc-links{display:flex;gap:8px;flex-wrap:wrap}.nc-actions{display:grid;gap:10px;margin-top:22px;text-align:center}
</style>
</Base>
