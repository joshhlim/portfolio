---
import Base from '../../layouts/Base.astro';
---
<Base title="Receipt extractor" description="Upload a receipt photo and get structured JSON back: merchant, date, line items and totals.">
<p class="eyebrow"><a href="/projects">← Projects</a></p>
<h1>Receipt extractor</h1>
<p class="mut lead">Upload or snap a receipt and get structured data back.</p>
<div class="rx">
  <div class="card rx-in">
    <label class="drop" for="rx-file">
      <img class="prev" alt="Receipt preview" hidden/>
      <span class="ph">Tap to upload or take a photo<small>JPG, PNG or WebP</small></span>
    </label>
    <input id="rx-file" type="file" accept="image/*" capture="environment" hidden/>
    <button class="btn" id="rx-go" type="button" disabled>Extract</button>
    <p class="note">Nothing is saved. Your image is processed once and discarded.</p>
  </div>
  <div class="card rx-out">
    <p class="mut empty" id="rx-msg">Results will appear here.</p>
    <div id="rx-res" hidden>
      <div class="meta" id="rx-meta"></div>
      <table><thead><tr><th>Item</th><th>Qty</th><th>Amount</th></tr></thead><tbody id="rx-items"></tbody><tfoot id="rx-tot"></tfoot></table>
      <button class="btn ghost" id="rx-copy" type="button">Copy JSON</button>
    </div>
  </div>
</div>
<script>
const $ = (id: string) => document.getElementById(id)!;
const input = $('rx-file') as HTMLInputElement, go = $('rx-go') as HTMLButtonElement;
const prev = document.querySelector<HTMLImageElement>('.prev')!, ph = document.querySelector<HTMLElement>('.ph')!;
const msg = $('rx-msg'), res = $('rx-res');
let blob: Blob | null = null, last: any = null;
async function shrink(f: File): Promise<Blob> {
  const img = await createImageBitmap(f);
  const s = Math.min(1, 2000 / Math.max(img.width, img.height));
  const c = document.createElement('canvas'); c.width = Math.round(img.width * s); c.height = Math.round(img.height * s);
  c.getContext('2d')!.drawImage(img, 0, 0, c.width, c.height);
  for (const q of [0.85, 0.7, 0.5]) {
    const b: Blob = await new Promise(r => c.toBlob(x => r(x!), 'image/jpeg', q));
    if (b.size < 3.8 * 1024 * 1024) return b;
  }
  throw new Error('too big');
}
function show(t: string, err = false) { res.hidden = true; msg.hidden = false; msg.textContent = t; msg.classList.toggle('err', err); }
input.addEventListener('change', async () => {
  const f = input.files?.[0]; if (!f) return;
  if (!f.type.startsWith('image/')) { show('Please choose an image file.', true); return; }
  try { blob = await shrink(f); } catch { blob = null; show("Couldn't read that image. Try another one.", true); return; }
  prev.src = URL.createObjectURL(blob); prev.hidden = false; ph.hidden = true;
  go.disabled = false; show('Ready. Press Extract.');
});
const fmt = (n: number | null) => n == null ? '–' : n.toFixed(2);
const esc = (s: string) => s.replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]!));
go.addEventListener('click', async () => {
  if (!blob) return;
  go.disabled = true; go.textContent = 'Extracting…'; show('Reading your receipt…');
  try {
    const fd = new FormData(); fd.append('image', blob, 'receipt.jpg');
    const r = await fetch('/api/extract', { method: 'POST', body: fd });
    const j = await r.json().catch(() => ({ error: 'Something went wrong. Please try again.' }));
    if (!r.ok) { show(j.error || 'Something went wrong.', true); return; }
    last = j; msg.hidden = true; res.hidden = false;
    $('rx-meta').innerHTML = `<strong>${esc(j.merchant ?? 'Unknown merchant')}</strong><span>${esc(j.date ?? '')}${j.currency ? ' · ' + esc(j.currency) : ''}</span>`;
    $('rx-items').innerHTML = (j.items || []).map((i: any) => `<tr><td>${esc(i.name)}</td><td>${i.quantity ?? ''}</td><td>${fmt(i.amount)}</td></tr>`).join('') || '<tr><td colspan="3" class="mut">No line items found</td></tr>';
    $('rx-tot').innerHTML = [['Subtotal', j.subtotal], ['Tax', j.tax], ['Total', j.total]].filter(([, v]) => v != null).map(([k, v]) => `<tr><td colspan="2">${k}</td><td>${fmt(v as number)}</td></tr>`).join('');
  } catch { show('Network error. Please try again.', true); }
  finally { go.disabled = false; go.textContent = 'Extract'; }
});
$('rx-copy').addEventListener('click', async () => {
  try { await navigator.clipboard.writeText(JSON.stringify(last, null, 2)); $('rx-copy').textContent = 'Copied!'; setTimeout(() => $('rx-copy').textContent = 'Copy JSON', 1500); } catch {}
});
</script>
<style>
.ph[hidden]{display:none}
.eyebrow a{color:var(--mut);font-size:.9rem}.lead{margin:-4px 0 28px}
.rx{display:grid;grid-template-columns:1fr 1.2fr;gap:20px;align-items:start;margin-bottom:56px}
.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:20px}
.drop{display:grid;place-items:center;min-height:260px;border:1.5px dashed var(--card-line);border-radius:12px;cursor:pointer;overflow:hidden;background:var(--bg);text-align:center}
.drop:hover{border-color:var(--acc)}.ph{color:var(--mut);display:flex;flex-direction:column;gap:4px;padding:20px}.ph small{font-size:.8rem}
.prev{max-width:100%;max-height:420px;display:block}
.btn{display:block;width:100%;margin-top:14px;padding:11px;border:0;border-radius:10px;background:var(--acc);color:var(--on-btn);font:inherit;font-weight:600;cursor:pointer}
.btn:disabled{opacity:.5;cursor:default}.btn.ghost{background:transparent;color:var(--acc);border:1px solid var(--card-line)}
.note{margin:12px 0 0;font-size:.8rem;color:var(--mut);text-align:center}
.empty{margin:0}.err{color:var(--dev-fg)}
.meta{display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;margin-bottom:12px}.meta span{color:var(--mut);font-size:.9rem}
table{width:100%;border-collapse:collapse;font-size:.92rem}th{text-align:left;color:var(--mut);font-weight:500;font-size:.8rem}
:global(.rx-out th),:global(.rx-out td){padding:7px 4px;border-bottom:1px solid var(--line)}:global(.rx-out th:nth-child(n+2)),:global(.rx-out td:nth-child(n+2)),:global(.rx-out tfoot td:last-child){text-align:right;white-space:nowrap}
:global(.rx-out tfoot td){font-weight:600;border-bottom:0}:global(.rx-out tfoot tr:last-child td){font-size:1rem}:global(.rx-out td.mut){color:var(--mut)}
@media(max-width:760px){.rx{grid-template-columns:1fr}.drop{min-height:180px}}
</style>
</Base>
