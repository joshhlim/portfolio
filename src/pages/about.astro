---
import Base from '../layouts/Base.astro';
import { about, pageDescriptions } from '../data/site';
---
<Base title="About" description={pageDescriptions.about}>
<p class="eyebrow reveal">About</p><h1 class="reveal">A bit about me</h1>
<p class="mut reveal" style="max-width:680px;font-size:1.08rem">{about.intro}</p>
<h2 class="reveal" style="margin-top:56px">Education</h2>
<div class="card reveal"><div class="row"><div><h3>{about.education.school}</h3><p class="mut" style="margin:0">{about.education.degree}</p></div><span class="mut">{about.education.when}</span></div>
</div>
<h2 class="reveal" style="margin-top:56px">Certifications</h2>
<div class="grid">{about.certifications.map(c=><a class="card reveal cert" href={c.url} target="_blank"><span class={"badge "+c.badge}>{c.badge}</span><div><h3 style="color:var(--fg)">{c.name}</h3><p class="mut" style="margin:0">{c.issuer}</p><p class="cd">{c.status} · Verify on Credly ↗</p></div></a>)}
{about.certificationsInProgress.map(c=><div class="card reveal cert wip"><span class={"badge "+c.badge}>{c.badge}</span><div><h3>{c.name}</h3><p class="mut" style="margin:0">{c.issuer}</p><p class="cd">{c.status}</p></div></div>)}</div>
<h2 class="reveal" style="margin-top:56px">Professional interests</h2>
<div class="grid">{about.interests.map(i=><div class="card reveal"><h3>{i.title}</h3><p class="mut" style="margin:0">{i.detail}</p></div>)}</div>
<h2 class="reveal" style="margin-top:56px">Hobbies</h2>
<div class="grid">{about.hobbies.map(h=><div class="card reveal"><h3>{h.title}</h3><p class="mut" style="margin:0">{h.detail}</p></div>)}</div>
<h2 class="reveal" style="margin-top:56px">Skills</h2>
<div class="reveal">{about.skills.map(s=><span class="tag">{s}</span>)}</div>
<style>.cert{display:flex;gap:16px;align-items:flex-start}.badge{flex:none;width:48px;height:48px;border-radius:12px;background:var(--aws-bg);color:var(--aws-fg);font-weight:700;font-size:.8rem;display:grid;place-items:center;border:1px solid var(--aws-line)}.cd{margin:10px 0 0;font-size:.88rem;color:var(--acc);font-weight:500}.wip{border-style:dashed}.badge.MS{background:var(--ms-bg);color:var(--ms-fg);border-color:var(--ms-line)}.wip .cd{color:var(--mut)}.row{display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap;margin-bottom:12px}</style>
</Base>
