---
import Base from '../layouts/Base.astro';
import { gambrole, pageDescriptions, smallerBuilds, workProjects } from '../data/site';
const icons={
cal:'<rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18M8 14h2M14 14h2M8 18h2M14 18h2"/>',
phone:'<path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"/>',
book:'<path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20V3H6.5A2.5 2.5 0 0 0 4 5.5z"/><path d="M8 7h8M8 11h6"/>',
avatar:'<circle cx="12" cy="8" r="4"/><path d="M4 21v-1a6 6 0 0 1 6-6h4a6 6 0 0 1 6 6v1"/><path d="M18.5 3.5a5 5 0 0 1 0 7"/>'};
---
<Base title="Projects" description={pageDescriptions.projects}>
<p class="eyebrow reveal">Projects</p><h1 class="reveal">Things I've built</h1>
<h2 class="reveal sec">Work projects</h2>
<p class="mut reveal sub">{workProjects.intro}</p>
<div class="wgrid">{workProjects.items.map(w=><article class="card reveal wk">
<div class="top"><span class="ico"><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" set:html={icons[w.icon]}/></span>{w.status && <span class={"st "+(w.status==='In UAT'?'uat':'dev')}><i></i>{w.status}</span>}</div>
<h3>{w.name}</h3><p class="mut">{w.detail}</p><div>{w.tags.map(t=><span class="tag">{t}</span>)}</div></article>)}</div>
<h2 class="reveal sec" style="margin-top:72px">Personal projects</h2>
<article class="card feat reveal">
<div class="im"><img src="/img/gambrole.png" alt="GamBROle preview"/></div>
<div class="bd"><p class="eyebrow">Featured</p><h2>GamBROle</h2>
<p class="mut">Score keeping and settlements for Big Two (Taidi) and Mahjong nights. It started as <a href={gambrole.originUrl} target="_blank">taidi-tracker</a>, a small Python script for lifetime Taidi stats, and grew into a full multiplayer web app.</p>
<div>{gambrole.tags.map(t=><span class="tag">{t}</span>)}</div>
<div class="lk"><a class="btn" href={gambrole.liveUrl} target="_blank">Live app ↗</a><a class="btn ghost" href={gambrole.repoUrl} target="_blank">GitHub ↗</a></div></div>
</article>
<div class="grid fs">{gambrole.features.map(f=><div class="card reveal"><h3>{f.title}</h3><p class="mut" style="margin:0">{f.detail}</p></div>)}</div>
<h3 class="reveal small">Smaller builds</h3>
<div class="grid">{smallerBuilds.map(b=><article class="card reveal"><h3>{b.name}</h3><p class="mut sdesc">{b.detail}</p><div>{b.tags.map(t=><span class="tag">{t}</span>)}</div><div class="slk"><a href={b.liveUrl} target={b.liveUrl.startsWith("/")?undefined:"_blank"}>{b.liveLabel}{b.liveUrl.startsWith("/")?" →":" ↗"}</a><a href={b.repoUrl} target="_blank">GitHub ↗</a></div></article>)}</div>
<p class="mut reveal more">More projects coming soon. In the meantime, see <a href="https://github.com/joshhlim" target="_blank">GitHub</a>.</p>
<style>.sec{margin:48px 0 6px}.sub{margin:0 0 24px}.wgrid{display:grid;gap:20px;grid-template-columns:repeat(2,1fr)}.wk p.mut{margin:12px 0 14px}.top{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:16px}.ico{width:48px;height:48px;border-radius:12px;display:grid;place-items:center;background:linear-gradient(135deg,var(--ico-a),var(--ico-b));color:var(--acc);border:1px solid var(--ico-line);transition:transform .3s}.wk:hover .ico{transform:rotate(-6deg) scale(1.06)}.st{display:inline-flex;align-items:center;gap:6px;font-size:.78rem;font-weight:600;padding:4px 10px;border-radius:99px}.st i{width:7px;height:7px;border-radius:50%;background:currentColor}.uat{background:var(--uat-bg);color:var(--uat-fg)}.dev{background:var(--dev-bg);color:var(--dev-fg)}@media(max-width:760px){.wgrid{grid-template-columns:1fr}}.feat{display:grid;grid-template-columns:1.2fr 1fr;padding:0;overflow:hidden;margin-top:24px}.im{overflow:hidden;background:var(--im-bg);border-right:1px solid var(--line);min-height:320px}.im img{width:100%;height:100%;object-fit:cover;transition:transform .6s}.feat:hover .im img{transform:scale(1.04)}.bd{padding:36px}.bd h2{margin:4px 0 12px}.lk{display:flex;gap:12px;margin-top:24px}.fs{margin-top:20px}.small{margin:40px 0 16px;font-size:1.25rem;letter-spacing:-.02em}.sdesc{margin:8px 0 12px}.slk{display:flex;gap:16px;margin-top:14px;font-weight:500;font-size:.92rem}.more{margin-top:40px;text-align:center}@media(max-width:800px){.feat{grid-template-columns:1fr}.im{border-right:0;border-bottom:1px solid var(--line);min-height:200px}}</style>
</Base>
