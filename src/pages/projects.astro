---
import Base from '../layouts/Base.astro';
const tags=['Python','FastAPI','TypeScript','Supabase','Vercel','Render','pytest'];
const feats=[['Configurable house rules','Scoring for Big Two (Taidi) and Mahjong, set up to match how each group plays.'],['Multiplayer rooms','Everyone joins from their own phone and the scores stay in sync.'],['Lifetime analytics','Tracks stats and settlements across every game night.']];
const icons={
cal:'<rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18M8 14h2M14 14h2M8 18h2M14 18h2"/>',
phone:'<path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"/>',
book:'<path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20V3H6.5A2.5 2.5 0 0 0 4 5.5z"/><path d="M8 7h8M8 11h6"/>',
avatar:'<circle cx="12" cy="8" r="4"/><path d="M4 21v-1a6 6 0 0 1 6-6h4a6 6 0 0 1 6 6v1"/><path d="M18.5 3.5a5 5 0 0 1 0 7"/>'};
const work=[
{n:'Staff Rostering Solution',ic:'cal',st:'In UAT',d:'A constraint programming system that assigns staff to shifts and locations based on a defined set of constraints.',t:['Constraint programming','AWS EC2']},
{n:'CarePal',ic:'phone',st:'In development',d:'Supports care connectors on post-discharge calls. It gives patients call summaries, asks post-discharge questions to check on their wellbeing, offers guidance to help prevent readmissions, and answers patient questions as a Q&A bot.',t:['Azure','Conversational AI']},
{n:'Enterprise RAG Bot',ic:'book',st:null,d:"Guides users through Synapxe's AgentSea platform, from creating their own agents to designing system prompts and working with knowledge spaces.",t:['RAG','AgentSea']},
{n:'Patient-facing Avatar',ic:'avatar',st:'In development',d:'Takes multilingual voice input and answers clinical onboarding questions using RAG, with a custom avatar that speaks the answers.',t:['Azure','RAG','Speech']},
];
---
<Base title="Projects">
<p class="eyebrow reveal">Projects</p><h1 class="reveal">Things I've built</h1>
<h2 class="reveal sec">Work projects</h2>
<p class="mut reveal sub">Internal AI projects at Ng Teng Fong General Hospital.</p>
<div class="wgrid">{work.map(w=><article class="card reveal wk">
<div class="top"><span class="ico"><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" set:html={icons[w.ic]}/></span>{w.st && <span class={"st "+(w.st==='In UAT'?'uat':'dev')}><i></i>{w.st}</span>}</div>
<h3>{w.n}</h3><p class="mut">{w.d}</p><div>{w.t.map(t=><span class="tag">{t}</span>)}</div></article>)}</div>
<h2 class="reveal sec" style="margin-top:72px">Personal project</h2>
<article class="card feat reveal">
<div class="im"><img src="/img/gambrole.png" alt="GamBROle preview"/></div>
<div class="bd"><p class="eyebrow">Featured</p><h2>GamBROle</h2>
<p class="mut">Score keeping and settlements for Big Two (Taidi) and Mahjong nights. It started as <a href="https://github.com/joshhlim/taidi-tracker" target="_blank">taidi-tracker</a>, a small Python script for lifetime Taidi stats, and grew into a full multiplayer web app.</p>
<div>{tags.map(t=><span class="tag">{t}</span>)}</div>
<div class="lk"><a class="btn" href="https://gambrole.vercel.app" target="_blank">Live app ↗</a><a class="btn ghost" href="https://github.com/joshhlim/gambrole" target="_blank">GitHub ↗</a></div></div>
</article>
<div class="grid fs">{feats.map(([t,d])=><div class="card reveal"><h3>{t}</h3><p class="mut" style="margin:0">{d}</p></div>)}</div>
<p class="mut reveal more">More projects coming soon. In the meantime, see <a href="https://github.com/joshhlim" target="_blank">GitHub</a>.</p>
<style>.sec{margin:48px 0 6px}.sub{margin:0 0 24px}.wgrid{display:grid;gap:20px;grid-template-columns:repeat(2,1fr)}.wk p.mut{margin:12px 0 14px}.top{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:16px}.ico{width:48px;height:48px;border-radius:12px;display:grid;place-items:center;background:linear-gradient(135deg,#eef2ff,#e0f2fe);color:var(--acc);border:1px solid #e0e7ff;transition:transform .3s}.wk:hover .ico{transform:rotate(-6deg) scale(1.06)}.st{display:inline-flex;align-items:center;gap:6px;font-size:.78rem;font-weight:600;padding:4px 10px;border-radius:99px}.st i{width:7px;height:7px;border-radius:50%;background:currentColor}.uat{background:#ecfdf5;color:#047857}.dev{background:#fffbeb;color:#b45309}@media(max-width:760px){.wgrid{grid-template-columns:1fr}}.feat{display:grid;grid-template-columns:1.2fr 1fr;padding:0;overflow:hidden;margin-top:24px}.im{overflow:hidden;background:#f3f4f6;border-right:1px solid var(--line);min-height:320px}.im img{width:100%;height:100%;object-fit:cover;transition:transform .6s}.feat:hover .im img{transform:scale(1.04)}.bd{padding:36px}.bd h2{margin:4px 0 12px}.lk{display:flex;gap:12px;margin-top:24px}.fs{margin-top:20px}.more{margin-top:40px;text-align:center}@media(max-width:800px){.feat{grid-template-columns:1fr}.im{border-right:0;border-bottom:1px solid var(--line);min-height:200px}}</style>
</Base>
