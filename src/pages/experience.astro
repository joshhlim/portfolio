---
import Base from '../layouts/Base.astro';
import { experience, pageDescriptions } from '../data/site';
---
<Base title="Experience" description={pageDescriptions.experience}>
<p class="eyebrow reveal">Experience</p><h1 class="reveal">Where I've worked</h1>
<ol class="tl">{experience.map(x=><li class="reveal"><span class="dot"></span><div class="card">
<div class="row"><div><h3>{x.role}</h3><p class="org">{x.org} <span class="mut">· {x.location}</span></p></div><span class="mut when">{x.when}</span></div>
<ul>{x.points.map(p=><li>{p}</li>)}</ul>{x.linkToProjects && <a class="mlink" href="/projects">See work projects →</a>}
</div></li>)}</ol>
<style>.mlink{display:inline-block;margin-top:12px;font-weight:500;font-size:.92rem}.tl{list-style:none;padding:0 0 0 28px;margin:40px 0 0;border-left:2px solid var(--line)}.tl>li{position:relative;margin-bottom:28px}.dot{position:absolute;left:-37px;top:28px;width:16px;height:16px;border-radius:50%;background:var(--card);border:3px solid var(--acc)}.row{display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap}.org{margin:0;font-weight:500}.when{font-size:.9rem}ul{margin:14px 0 0;padding-left:20px}ul li{margin:4px 0}</style>
</Base>
