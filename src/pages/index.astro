---
import Base from '../layouts/Base.astro';
import { home, pageDescriptions, site } from '../data/site';
---
<Base title="Home" description={pageDescriptions.home}>
<section class="hero"><div class="reveal">
<p class="eyebrow">{home.eyebrow}</p>
<h1>{home.headline}</h1>
<p class="tagline">"{site.tagline}"</p>
<p class="mut lead">{home.intro}</p>
<div class="cta"><a class="btn" href="/projects">View projects</a><a class="btn ghost" href="/contact">Get in touch</a></div></div>
<img class="reveal av" src="/img/avatar.svg" alt="Josh Lim avatar placeholder"/></section>
<section class="grid stats">
{home.cards.map(c=><div class="card reveal"><p class="eyebrow">{c.eyebrow}</p><h3>{c.title}</h3><p class="mut">{c.detail}</p></div>)}
</section>
<style>.hero{display:grid;grid-template-columns:1.6fr 1fr;gap:48px;align-items:center;padding:40px 0 64px}.tagline{font-size:1.2rem;font-style:italic;color:var(--acc);margin:0 0 14px}.lead{font-size:1.12rem;max-width:600px}.cta{display:flex;gap:12px;margin-top:28px}.av{width:100%;max-width:280px;justify-self:center;animation:float 6s ease-in-out infinite}@keyframes float{50%{translate:0 -10px}}@media(max-width:760px){.hero{grid-template-columns:1fr}.av{max-width:180px;grid-row:1}}</style>
</Base>
