---
import { navLinks, site } from '../data/site';
const { title, description = site.description, bare = false } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const fullTitle = `${title} · ${site.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/img/og.png', Astro.site);
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>{fullTitle}</title><meta name="description" content={description}/>
<link rel="canonical" href={canonical}/>
<meta property="og:type" content="website"/><meta property="og:site_name" content={site.name}/><meta property="og:title" content={fullTitle}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:image" content={ogImage}/><meta property="og:image:width" content="1200"/><meta property="og:image:height" content="630"/><meta property="og:image:alt" content="Josh Lim, AI Engineer in Singapore"/>
<meta name="twitter:card" content="summary_large_image"/>
<meta name="theme-color" content="#fafafa" media="(prefers-color-scheme: light)"/><meta name="theme-color" content="#0f1117" media="(prefers-color-scheme: dark)"/>
<link rel="preconnect" href="https://fonts.googleapis.com"/><link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet"/>
<link rel="icon" href="/img/avatar.svg"/>
<script is:inline>
(function(){var s=null;try{s=localStorage.getItem('theme')}catch(e){}
document.documentElement.dataset.theme=s||(matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light')})();
</script></head>
<body class={bare?'bare':undefined}><header class="nav"><div class="wrap navin"><a href="/" class="logo">{site.name}</a><div class="navr"><nav>{navLinks.map(([h,l])=> <a href={h} class={path===h?'active':''} aria-current={path===h?'page':undefined}>{l}</a>)}</nav>
<button class="theme" type="button" aria-label="Switch color theme"><svg class="moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg><svg class="sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg></button></div></div></header>
<main class="wrap"><slot/></main>
<footer class="wrap foot">© 2026 {site.name} · Built with Astro</footer>
<script>
const io=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target)}}),{threshold:.12});
document.querySelectorAll('.reveal').forEach((el,i)=>{el.style.transitionDelay=(i%4)*80+'ms';io.observe(el)});
const root=document.documentElement;
document.querySelector('.theme').addEventListener('click',()=>{const t=root.dataset.theme==='dark'?'light':'dark';root.dataset.theme=t;try{localStorage.setItem('theme',t)}catch(e){}});
matchMedia('(prefers-color-scheme: dark)').addEventListener('change',e=>{let saved=null;try{saved=localStorage.getItem('theme')}catch(err){}if(!saved)root.dataset.theme=e.matches?'dark':'light'});
</script>
<style is:global>
:root{color-scheme:light;--bg:#fafafa;--fg:#111827;--mut:#6b7280;--line:#e5e7eb;--acc:#4f46e5;--card:#fff;--nav:rgba(250,250,250,.85);--hover:#f0f0f3;--active:#eef2ff;--card-line:#c7d2fe;--shadow:rgba(17,24,39,.15);--on-btn:#fff;--tag-bg:#eef2ff;--tag-fg:#4338ca;--ico-a:#eef2ff;--ico-b:#e0f2fe;--ico-line:#e0e7ff;--uat-bg:#ecfdf5;--uat-fg:#047857;--dev-bg:#fffbeb;--dev-fg:#b45309;--aws-bg:#fff7ed;--aws-fg:#c2410c;--aws-line:#fed7aa;--ms-bg:#eff6ff;--ms-fg:#1d4ed8;--ms-line:#bfdbfe;--im-bg:#f3f4f6;--h0:#ebedf0;--h1:#9be9a8;--h2:#40c463;--h3:#30a14e;--h4:#216e39}
[data-theme=dark]{color-scheme:dark;--bg:#0f1117;--fg:#f3f4f6;--mut:#9ca3af;--line:#272b35;--acc:#a5b4fc;--card:#171a21;--nav:rgba(15,17,23,.85);--hover:#20242d;--active:#262b45;--card-line:#4b5280;--shadow:rgba(0,0,0,.5);--on-btn:#111827;--tag-bg:#262b45;--tag-fg:#c7d2fe;--ico-a:#232846;--ico-b:#16303f;--ico-line:#31375c;--uat-bg:#0f2f26;--uat-fg:#6ee7b7;--dev-bg:#33270c;--dev-fg:#fcd34d;--aws-bg:#33200f;--aws-fg:#fdba74;--aws-line:#5c3517;--ms-bg:#14233f;--ms-fg:#93c5fd;--ms-line:#1e3a66;--im-bg:#20242d;--h0:#20242d;--h1:#0e4429;--h2:#006d32;--h3:#26a641;--h4:#39d353}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--fg);font-family:Inter,system-ui,sans-serif;line-height:1.65;-webkit-font-smoothing:antialiased}
a{color:var(--acc);text-decoration:none}.wrap{max-width:1040px;margin:0 auto;padding:0 24px}
.nav{position:sticky;top:0;z-index:10;background:var(--nav);backdrop-filter:blur(10px);border-bottom:1px solid var(--line)}
.navin{display:flex;justify-content:space-between;align-items:center;height:64px}.logo{font-weight:700;color:var(--fg);letter-spacing:-.02em}.navr{display:flex;align-items:center;gap:6px}
nav{display:flex;gap:6px;flex-wrap:wrap}nav a{color:var(--mut);padding:6px 12px;border-radius:8px;font-size:.93rem;transition:.2s}nav a:hover{color:var(--fg);background:var(--hover)}nav a.active{color:var(--fg);background:var(--active)}
.theme{flex:none;display:grid;place-items:center;width:36px;height:36px;padding:0;color:var(--mut);background:transparent;border:0;border-radius:8px;cursor:pointer;transition:.2s}.theme:hover{color:var(--fg);background:var(--hover)}.theme .sun{display:none}[data-theme=dark] .theme .sun{display:block}[data-theme=dark] .theme .moon{display:none}
main.wrap{min-height:70vh;padding:56px 24px 80px}h1{font-size:clamp(2.2rem,5vw,3.4rem);letter-spacing:-.035em;line-height:1.1;margin:0 0 16px}
h2{font-size:1.6rem;letter-spacing:-.02em;margin:0 0 20px}h3{margin:0 0 4px;font-size:1.1rem}.mut{color:var(--mut)}.eyebrow{color:var(--acc);font-weight:600;font-size:.85rem;text-transform:uppercase;letter-spacing:.1em}
.card{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:24px;transition:transform .25s,box-shadow .25s,border-color .25s}.card:hover{transform:translateY(-4px);box-shadow:0 12px 30px -12px var(--shadow);border-color:var(--card-line)}
.btn{display:inline-block;padding:10px 18px;border-radius:10px;background:var(--fg);color:var(--on-btn);font-weight:500;transition:.2s}.btn:hover{background:var(--acc)}.btn.ghost{background:transparent;color:var(--fg);border:1px solid var(--line)}.btn.ghost:hover{border-color:var(--acc);color:var(--acc)}
.tag{display:inline-block;font-size:.78rem;padding:3px 10px;border-radius:99px;background:var(--tag-bg);color:var(--tag-fg);margin:3px 4px 0 0}
.reveal{opacity:0;transform:translateY(18px);transition:opacity .7s ease,transform .7s ease}.reveal.in{opacity:1;transform:none}
.grid{display:grid;gap:20px;grid-template-columns:repeat(auto-fit,minmax(300px,1fr))}
body.bare .nav nav,body.bare .nav .logo,body.bare .foot{display:none}body.bare .nav{position:fixed;top:0;right:0;background:none;border:0;backdrop-filter:none}body.bare .navin{height:auto;padding:10px}body.bare main.wrap{padding:24px 16px 40px}
.foot{border-top:1px solid var(--line);padding:28px 24px;color:var(--mut);font-size:.88rem}
@media (prefers-reduced-motion:reduce){.reveal{opacity:1;transform:none;transition:none}}
@media (max-width:640px){.navin{height:auto;padding:12px 24px;flex-direction:column;gap:8px}.navin{position:relative}.theme{position:absolute;top:6px;right:16px}nav{justify-content:center}}
</style></body></html>
