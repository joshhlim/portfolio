---
const { title } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const links = [['/', 'Home'], ['/about', 'About'], ['/experience', 'Experience'], ['/projects', 'Projects'], ['/contact', 'Contact']];
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>{title} · Josh Lim</title><meta name="description" content="Josh Lim, AI Engineer in Singapore"/>
<link rel="preconnect" href="https://fonts.googleapis.com"/><link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet"/>
<link rel="icon" href="/img/avatar.svg"/></head>
<body><header class="nav"><div class="wrap navin"><a href="/" class="logo">Josh Lim</a><nav>{links.map(([h,l])=> <a href={h} class={path===h?'active':''}>{l}</a>)}</nav></div></header>
<main class="wrap"><slot/></main>
<footer class="wrap foot">© 2026 Josh Lim · Built with Astro</footer>
<script>
const io=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target)}}),{threshold:.12});
document.querySelectorAll('.reveal').forEach((el,i)=>{el.style.transitionDelay=(i%4)*80+'ms';io.observe(el)});
</script>
<style is:global>
:root{--bg:#fafafa;--fg:#111827;--mut:#6b7280;--line:#e5e7eb;--acc:#4f46e5;--card:#fff}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--fg);font-family:Inter,system-ui,sans-serif;line-height:1.65;-webkit-font-smoothing:antialiased}
a{color:var(--acc);text-decoration:none}.wrap{max-width:1040px;margin:0 auto;padding:0 24px}
.nav{position:sticky;top:0;z-index:10;background:rgba(250,250,250,.85);backdrop-filter:blur(10px);border-bottom:1px solid var(--line)}
.navin{display:flex;justify-content:space-between;align-items:center;height:64px}.logo{font-weight:700;color:var(--fg);letter-spacing:-.02em}
nav{display:flex;gap:6px;flex-wrap:wrap}nav a{color:var(--mut);padding:6px 12px;border-radius:8px;font-size:.93rem;transition:.2s}nav a:hover{color:var(--fg);background:#f0f0f3}nav a.active{color:var(--fg);background:#eef2ff}
main{min-height:70vh;padding:56px 24px 80px}h1{font-size:clamp(2.2rem,5vw,3.4rem);letter-spacing:-.035em;line-height:1.1;margin:0 0 16px}
h2{font-size:1.6rem;letter-spacing:-.02em;margin:0 0 20px}h3{margin:0 0 4px;font-size:1.1rem}.mut{color:var(--mut)}.eyebrow{color:var(--acc);font-weight:600;font-size:.85rem;text-transform:uppercase;letter-spacing:.1em}
.card{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:24px;transition:transform .25s,box-shadow .25s,border-color .25s}.card:hover{transform:translateY(-4px);box-shadow:0 12px 30px -12px rgba(17,24,39,.15);border-color:#c7d2fe}
.btn{display:inline-block;padding:10px 18px;border-radius:10px;background:var(--fg);color:#fff;font-weight:500;transition:.2s}.btn:hover{background:var(--acc)}.btn.ghost{background:transparent;color:var(--fg);border:1px solid var(--line)}.btn.ghost:hover{border-color:var(--acc);color:var(--acc)}
.tag{display:inline-block;font-size:.78rem;padding:3px 10px;border-radius:99px;background:#eef2ff;color:#4338ca;margin:3px 4px 0 0}
.ph{background:#fef3c7;color:#92400e;padding:0 4px;border-radius:4px}
.reveal{opacity:0;transform:translateY(18px);transition:opacity .7s ease,transform .7s ease}.reveal.in{opacity:1;transform:none}
.grid{display:grid;gap:20px;grid-template-columns:repeat(auto-fit,minmax(300px,1fr))}
.foot{border-top:1px solid var(--line);padding:28px 24px;color:var(--mut);font-size:.88rem}
@media (prefers-reduced-motion:reduce){.reveal{opacity:1;transform:none;transition:none}}
@media (max-width:640px){.navin{height:auto;padding:12px 24px;flex-direction:column;gap:8px}}
</style></body></html>
